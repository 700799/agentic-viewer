        "$ref": "#/$defs/SpanInput"
      },
      "title": "Spans",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/EdgeInput"
      },
      "title": "Edges",
      "type": "array"
    }
